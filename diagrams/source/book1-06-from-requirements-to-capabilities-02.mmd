flowchart LR
    subgraph EX["交互层"]
        U[用户与人工协作者] <--> UI[目标、计划、状态<br/>授权与证据]
    end

    subgraph CORE["Agent 决策层"]
        UI <--> A[理解、规划<br/>选择下一步]
        A <--> C[当前上下文<br/>任务状态]
    end

    subgraph RES["信息与执行资源"]
        M[可管理的用户记忆]
        K[权限感知的知识库]
        W[确定性工作流<br/>业务规则]
        T[工具与业务系统]
    end

    A <--> M
    A <--> K
    A <--> W
    W <--> T
    A <--> T

    subgraph GOV["治理与可观测性"]
        P[身份、权限<br/>安全控制]
        E[评估、日志<br/>成本监控]
    end

    P -.约束.-> UI
    P -.约束.-> A
    P -.约束.-> K
    P -.约束.-> T
    E -.观察.-> UI
    E -.观察.-> A
    E -.观察.-> W
    E -.观察.-> T
